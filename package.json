{
  "name": "electron",
  "version": "3.1.1",
  "license": "MIT",
  "homepage": "https://www.dfusion.ai",
  "author": {
    "name": "dFusion AI",
    "url": "https://www.dfusion.ai",
    "email": "dao@dfusion.ai"
  },
  "description": "dFusion Private Social Lens DLP miner application.",
  "scripts": {
    "postinstall": "electron-builder install-app-deps"
  },
  "main": "dist/apps/electron/main.js",
  "build": {
    "appId": "com.electron.dfusionVpslMiner",
    "productName": "dFusion-DLP-miner",
    "asar": true,
    "publish": [
      {
        "provider": "s3",
        "bucket": "dfusionai-dlp-miner",
        "path": "updates",
        "region": "us-east-1",
        "acl": null
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}.${ext}",
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "apps/electron/build/entitlements.mac.plist",
      "entitlementsInherit": "apps/electron/build/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "notarize": true
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "executableName": "dfusion-dlp-miner",
      "artifactName": "${productName}-${version}.${ext}",
      "category": "Utility",
      "description": "dFusion Private Social Lens DLP miner application."
    },
    "files": [
      "dist/apps/electron/**/*",
      "!dist/apps/electron/dev-app-update.yml"
    ],
    "extraResources": [
      {
        "from": "apps/electron/build",
        "to": "build",
        "filter": [
          "entitlements.mac.plist"
        ]
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.1.7",
    "@angular/common": "20.1.7",
    "@angular/compiler": "20.1.7",
    "@angular/core": "20.1.7",
    "@angular/forms": "20.1.7",
    "@angular/platform-browser": "20.1.7",
    "@angular/platform-browser-dynamic": "20.1.7",
    "@angular/router": "20.1.7",
    "@reown/appkit": "^1.7.2",
    "@reown/appkit-adapter-wagmi": "^1.7.2",
    "@toruslabs/eccrypto": "^6.0.2",
    "axios": "^1.11.0",
    "buffer": "^6.0.3",
    "call-bind-apply-helpers": "^1.0.2",
    "electron-log": "^5.3.3",
    "electron-store": "8.2",
    "electron-updater": "^6.6.2",
    "ethers": "^6.13.5",
    "openpgp": "^6.1.0",
    "pinata-web3": "^0.5.4",
    "rxjs": "~7.8.0",
    "telegram": "^2.26.21",
    "viem": "^2.26.5",
    "wagmi": "^2.14.16",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.1.6",
    "@angular-devkit/core": "20.1.6",
    "@angular-devkit/schematics": "20.1.6",
    "@angular/cdk": "^20.1.6",
    "@angular/cli": "~20.1.0",
    "@angular/compiler-cli": "20.1.7",
    "@angular/language-service": "20.1.7",
    "@angular/material": "20.1.6",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "21.3.11",
    "@nx/cypress": "21.3.11",
    "@nx/eslint": "21.3.11",
    "@nx/eslint-plugin": "21.3.11",
    "@nx/jest": "21.3.11",
    "@nx/js": "21.3.11",
    "@nx/web": "21.3.11",
    "@nx/workspace": "21.3.11",
    "@schematics/angular": "20.1.6",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/jest": "30.0.0",
    "@types/node": "18.16.9",
    "@typescript-eslint/utils": "^8.33.1",
    "angular-eslint": "20.0.0",
    "autoprefixer": "^10.4.0",
    "cypress": "14.2.1",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "10.0.0",
    "eslint-plugin-cypress": "^3.5.0",
    "jest": "30.0.5",
    "jest-environment-jsdom": "30.0.5",
    "jest-environment-node": "^29.7.0",
    "jest-preset-angular": "15.0.0",
    "jest-util": "30.0.5",
    "nx": "21.3.11",
    "nx-electron": "^20.0.2",
    "postcss": "^8.4.5",
    "prettier": "^2.6.2",
    "tailwindcss": "^3.0.2",
    "ts-jest": "29.4.1",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.33.1"
  }
}
